{
  "lastChangelogVersion": "0.85.1",
  "defaultProvider": "gateway",
  "defaultModel": "gpt-5.6-terra",
  "defaultThinkingLevel": "medium",
  "shellPath": "/opt/homebrew/bin/fish",
  "packages": [
    "npm:pi-zentui",
    "npm:@plannotator/pi-extension",
    "npm:pi-mcp-adapter",
    "npm:pi-web-access",
    "npm:@wichayutdew/pi-workflows"
  ],
  "terminal": {
    "showTerminalProgress": true,
    "clearOnShrink": true,
    "imageWidthCells": 60
  },
  "doubleEscapeAction": "tree",
  "treeFilterMode": "all",
  "compaction": {
    "enabled": true,
    "reserveTokens": 32768,
    "keepRecentTokens": 24000
  },
  "enableSkillCommands": false,
  "editorPaddingX": 2,
  "autocompleteMaxVisible": 3,
  "transport": "auto",
  "quietStartup": false,
  "outputPad": 1,
  "theme": "light/dark"
}