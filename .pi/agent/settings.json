{
  "lastChangelogVersion": "1.1.0",
  "defaultProvider": "gateway",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "medium",
  "shellPath": "/opt/homebrew/bin/fish",
  "packages": [
    "npm:@plannotator/pi-extension",
    "npm:pi-web-access"
  ],
  "terminal": {
    "showTerminalProgress": true,
    "clearOnShrink": true,
    "imageWidthCells": 60
  },
  "doubleEscapeAction": "tree",
  "treeFilterMode": "all",
  "compaction": {
    "enabled": true,
    "reserveTokens": 32768,
    "keepRecentTokens": 24000
  },
  "enableSkillCommands": true,
  "editorPaddingX": 2,
  "autocompleteMaxVisible": 3,
  "transport": "auto",
  "quietStartup": false,
  "outputPad": 1,
  "theme": "system",
  "extensions": [
    "/Users/wphongphanpa/.hindsight/coding-agents/dist/pi.js"
  ]
}